<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<appSettings>
		<add key="Repositories" value="DAL.Repositories.SqlServer" />
		<add key="RepositoriesSL" value="SL.DAL.Repositories.SqlServer" />
		<add key="UIComponent" value="UI" />
		<add key="BLLComponent" value="BLL" />
		<add key="DALComponent" value="DAL" />
		<add key="SLComponent" value="SL" />
		<add key="DefaultLanguage" value="Español" />
		<add key="DefaultCurrency" value="ARS" />
		<add key="BackupPath" value="Backups\BudgeeBackup.bin" />
		<add key="HelpPath_Español" value="Help es-ES.chm" />
		<add key="HelpPath_English" value="Help en-US.chm" />
		<add key="IncomingTasksRange_Minutes" value="60"/>
		<add key="FrecuenciaTrackSesion_Magnitud" value="Minutos"/>
		<add key="FrecuenciaTrackSesion_Valor" value="1"/>
		<add key="TaskCollectorDelay_ms" value="1500"/>
		<add key="NotificationCollectorDelay_ms" value="4000"/>
		<add key="Español" value="i18n\idioma.es-ES"/>
		<add key="English" value="i18n\idioma.en-US"/>
	</appSettings>
	<connectionStrings>
		<add name="BudgeeEntities" connectionString="metadata=res://*/Repositories.SqlServer.Models.BudgeeModel.csdl|res://*/Repositories.SqlServer.Models.BudgeeModel.ssdl|res://*/Repositories.SqlServer.Models.BudgeeModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=.\SQLEXPRESS;initial catalog=Budgee;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<add name="BudgeeSLEntities" connectionString="metadata=res://*/DAL.Repositories.SqlServer.Models.BudgeeSLModel.csdl|res://*/DAL.Repositories.SqlServer.Models.BudgeeSLModel.ssdl|res://*/DAL.Repositories.SqlServer.Models.BudgeeSLModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=.\SQLEXPRESS;initial catalog=Budgee;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
		<add name="MainConString" connectionString="data source=.\SQLEXPRESS;initial catalog=Budgee;integrated security=True;"/>
	</connectionStrings>
	<entityFramework>
		<providers>
			<provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
		</providers>
	</entityFramework>
	<log4net>
		<root>
			<level value="ALL" />
		</root>
		<logger name="InfoLogger" additivity="False">
			<level value="ALL" />
			<appender-ref ref="RollingFileAppender_Info" />
		</logger>
		<logger name="ErrorLogger" additivity="False">
			<level value="ALL" />
			<appender-ref ref="RollingFileAppender_Error" />
		</logger>

		<appender name="RollingFileAppender_Info" type="log4net.Appender.RollingFileAppender">
			<file value="Logs\Info.log" />
			<preserveLogFileNameExtension value="true" />
			<encoding value="utf-8" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<!-- formato de fecha (definirá la cantidad de logs) -->
			<datePattern value="' 'yyyy-MM-dd" /> <!--<datePattern value="yyyy-MM-dd" />-->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date > (%level) %message%n" />
				<!-- formato de logeo 2: "%date > %logger > %level:: %message%n"-->
				<!-- formato de logeo 3: "%date > [%logger]{%method} > %level:: %message%n" -->
			</layout>
		</appender>

		<appender name="RollingFileAppender_Error" type="log4net.Appender.RollingFileAppender">
			<file value="Logs\Error.log" />
			<preserveLogFileNameExtension value="true" />
			<encoding value="utf-8" />
			<appendToFile value="true" />
			<rollingStyle value="Date" />
			<datePattern value="' 'yyyy-MM-dd" />
			<!--<datePattern value="yyyy-MM-dd" />-->
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date > (%level) %message%n" />
			</layout>
		</appender>
	</log4net>
</configuration>